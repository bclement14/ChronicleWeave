# Copy to .env (gitignored) and adjust.
# Craig username (without the "N-" prefix and leading underscores) : speaker tag used in the script.
CW_SPEAKERS=player_one:Titar,gamemaster:GM,penny42:Pen,player_three:Khalebe,playerfour:Kashkyst
